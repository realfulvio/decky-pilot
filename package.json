{
  "name": "deckpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.14 <25"
  },
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests/frontend",
    "test": "vitest run",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "preview": "vite --host 127.0.0.1",
    "verify": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm test:tooling && corepack pnpm build"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "26.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-replace": "5.0.7",
    "@rollup/plugin-typescript": "11.1.6",
    "rollup-plugin-external-globals": "0.11.0",
    "rollup-plugin-import-assets": "1.1.1",
    "@decky/ui": "4.12.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rollup": "npm:@rollup/wasm-node@4.64.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "jsdom": "30.1.2",
    "@testing-library/react": "16.3.3",
    "eslint": "9.39.1",
    "typescript-eslint": "8.71.2",
    "ajv": "8.20.0",
    "@playwright/test": "1.64.0"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.64.5"
    }
  },
  "description": "Decky Pilot: visual game help and voice with your choice of AI service.",
  "repository": {
    "type": "git",
    "url": "https://github.com/realfulvio/decky-pilot.git"
  },
  "homepage": "https://github.com/realfulvio/decky-pilot",
  "bugs": {
    "url": "https://github.com/realfulvio/decky-pilot/issues"
  }
}
