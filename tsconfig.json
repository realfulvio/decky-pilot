  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "lib": ["DOM", "ES2020"]
